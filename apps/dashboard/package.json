{
    "name": "@camp_candor/dashboard",
    "version": "0.3.1",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "astro dev",
        "build": "astro build",
        "preview": "npm run build && wrangler dev",
        "astro": "astro",
        "deploy": "npm run build && wrangler deploy",
        "cf-typegen": "wrangler types",
        "check:ascii": "node scripts/verify-ascii.mjs",
        "verify:bundle": "node src/test/verify-bundle.mjs",
        "verify:middleware": "node src/test/verify-bundle.mjs",
        "lint:check": "eslint .",
        "lint:fix": "eslint . --fix",
        "test": "vitest run --exclude src/e2e.test.ts",
        "test:unit": "vitest run --exclude src/e2e.test.ts",
        "test:e2e": "start-server-and-test dev http://localhost:4321 'vitest run src/e2e.test.ts'",
        "gauntlet": "node scripts/verify-ascii.mjs && vitest run --exclude src/e2e.test.ts"
    },
    "dependencies": {
        "@astrojs/cloudflare": "^13.5.1",
        "@astrojs/react": "7.0.1",
        "@clerk/astro": "^3.0.15",
        "@tailwindcss/vite": "^4.2.2",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "astro": "^6.3.3",
        "nanostores": "^1.2.0",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "tailwindcss": "^4.2.2"
    },
    "devDependencies": {
        "eslint-plugin-astro": "^1.5.0",
        "prettier-plugin-astro": "^0.14.1"
    }
}
