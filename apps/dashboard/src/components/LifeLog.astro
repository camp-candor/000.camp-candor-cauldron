---

<section class="px-6 py-20 space-y-12">
  <div class="flex items-center gap-4">
    <div class="h-[1px] bg-primary dark:bg-paper/20 flex-grow"></div>
    <h3
      class="text-xl font-black uppercase tracking-tight flex items-center gap-2"
    >
      <span class="material-symbols-outlined text-xl">skull</span> Life Log
    </h3>
    <div class="h-[1px] bg-primary dark:bg-paper/20 flex-grow"></div>
  </div>
  <div class="grid grid-cols-1 gap-12">
    {
      threats.map((threat) => (
        <a
          href="/guest/viewer"
          class="block cursor-pointer group quest-border bg-paper dark:bg-zinc-900 dark:border-paper/20 p-4"
        >
          <img
            alt={threat.name}
            class="w-full h-72 object-cover stipple-effect grayscale mb-4 border border-primary"
            src={threat.image}
          />
          <div class="space-y-1">
            <h4 class="font-black uppercase text-lg border-b border-primary dark:border-paper/20 pb-1">
              {threat.name}
            </h4>
            <p class="text-xs italic font-serif">{threat.location}</p>
            <p class="text-[10px] font-mono text-red-700 font-bold uppercase mt-2">
              {threat.warning}
            </p>
          </div>
        </a>
      ))
    }
  </div>
</section>
