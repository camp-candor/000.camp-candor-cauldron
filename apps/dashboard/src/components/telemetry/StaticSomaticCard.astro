---
/**
 * apps/dashboard/src/components/telemetry/StaticSomaticCard.astro
 *
 * Pure Server-Rendered Somatic Constraint Presentation Card.
 * Zero Client-Side JavaScript (0 KB Bundle Overhead).
 * Displays immutable anatomical capacity and banned kinetic verbs from Axis A canon.
 */

export interface SomaticMaskPayload {
  readonly actorId: string;
  readonly availableArms: number;
  readonly bannedKineticVerbs: readonly string[];
  readonly sensoryAcuity: {
    readonly visualAcuity: number;
    readonly auditoryAcuity: number;
  };
  readonly activeConditions: readonly string[];
}

interface Props {
  readonly actorName: string;
  readonly mask: SomaticMaskPayload;
}

const { actorName, mask } = Astro.props;
---

<div class="bg-neutral-900 border border-neutral-800 rounded p-4 font-mono text-xs text-neutral-300 select-none">
  <!-- Card Header -->
  <div class="flex items-center justify-between border-b border-neutral-800 pb-2 mb-3">
    <div class="flex items-center gap-2">
      <span class="inline-block w-2 h-2 rounded-full bg-emerald-500"></span>
      <span class="font-bold text-neutral-100 tracking-wider">CANONICAL SOMATIC BASELINE</span>
    </div>
    <span class="text-[10px] bg-neutral-800 text-neutral-400 px-1.5 py-0.5 rounded border border-neutral-700">
      SSR_STATIC (0 KB JS)
    </span>
  </div>

  <!-- Body Metrics Grid -->
  <div class="space-y-2">
    <div class="flex justify-between items-center py-1 border-b border-neutral-800/50">
      <span class="text-neutral-500">ACTOR_TARGET:</span>
      <span class="text-neutral-100 font-semibold">{actorName} ({mask.actorId})</span>
    </div>

    <div class="flex justify-between items-center py-1 border-b border-neutral-800/50">
      <span class="text-neutral-500">AVAILABLE_ARMS:</span>
      <span class="text-emerald-400 font-bold">{mask.availableArms.toFixed(1)}</span>
    </div>

    <div class="flex justify-between items-center py-1 border-b border-neutral-800/50">
      <span class="text-neutral-500">VISUAL_ACUITY:</span>
      <span class="text-neutral-200">{(mask.sensoryAcuity.visualAcuity * 100).toFixed(0)}%</span>
    </div>

    <div class="flex justify-between items-center py-1 border-b border-neutral-800/50">
      <span class="text-neutral-500">AUDITORY_ACUITY:</span>
      <span class="text-neutral-200">{(mask.sensoryAcuity.auditoryAcuity * 100).toFixed(0)}%</span>
    </div>

    <!-- Banned Kinetic Verbs -->
    <div class="pt-2">
      <span class="text-neutral-500 block mb-1">BANNED_KINETIC_VERBS:</span>
      <div class="flex flex-wrap gap-1">
        {mask.bannedKineticVerbs.length === 0 ? (
          <span class="text-neutral-600 italic">NONE (UNRESTRICTED)</span>
        ) : (
          mask.bannedKineticVerbs.map((verb) => (
            <span class="bg-red-950/60 border border-red-800/50 text-red-400 px-1.5 py-0.5 rounded text-[10px]">
              {verb}
            </span>
          ))
        )}
      </div>
    </div>
  </div>

  <!-- Static Proof Stamp -->
  <div class="mt-4 pt-2 border-t border-neutral-800 flex justify-between text-[10px] text-neutral-600">
    <span>PROJECTION: DEEP_FROZEN</span>
    <span>RUNTIME: CPU_ONLY</span>
  </div>
</div>
