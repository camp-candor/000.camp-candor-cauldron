# ==============================================================================
# :: 995.LIBRARY & FLEET MONOREPO CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env at the monorepo root:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GITHUB CONTROL PLANE CREDENTIALS
# ------------------------------------------------------------------------------
# Either key name is accepted by the control plane and GitHub CLI:
GH_TOKEN=ghp_yourPersonalAccessTokenHere36CharsMin
GITHUB_TOKEN=ghp_yourPersonalAccessTokenHere36CharsMin

# Default GitHub organization or user account to target for Git operations
GITHUB_DEFAULT_OWNER=your-github-username-or-org

# Webhook payload verification secret (packages/132.github)
GH_WEBHOOK_SECRET=your_github_webhook_secret_here
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# ------------------------------------------------------------------------------
# 2. CLOUDFLARE EDGE & AI GATEWAY CREDENTIALS
# ------------------------------------------------------------------------------
# Cloudflare Account ID (found on Cloudflare Dashboard URL or Workers overview)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# Cloudflare API Token with Workers, Durable Objects, and AI permissions
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# Aliases used by packages/133.cloudflare:
CLOUDFLARE_ACCOUNT=your_cloudflare_account_id_here
CLOUDFLARE_WORKERS_TOKEN=your_cloudflare_api_token_here

# Cloudflare AI Gateway Slug (e.g., 'default' or custom gateway name)
CLOUDFLARE_AI_GATEWAY=default

# Optional: Cloudflare AI Gateway Universal Token (format: cfut_...)
CLOUDFLARE_AI_GATEWAY_TOKEN=

# ------------------------------------------------------------------------------
# 3. ROUTING & SWITCHBOARD POINTERS
# ------------------------------------------------------------------------------
# URL of your deployed Cloudflare Worker (Tier 3 fallback in cascade.ts).
# Default to loopback during local development:
LIVE_WORKER_URL=http://127.0.0.1:8787
WORKER_URL=http://127.0.0.1:8787

# ------------------------------------------------------------------------------
# 4. MASTER STOREHOUSE & FLEET ROOT OVERRIDES (OPTIONAL)
# ------------------------------------------------------------------------------
# Explicitly overrides the multi-tenant root directory crawl.
# If left blank, resolveFleetRoot dynamically crawls upward for sentinel lockfiles.
#
# FLEET_ROOT:
#   The canonical, domain-specific variable for the repository fleet architecture.
#   Used when explicitly pinning the master multi-tenant workspace root (e.g. d:/cauldron-it-com).
#   Takes highest precedence in resolveFleetRoot.
#
# WORK_DIR:
#   A generalized compatibility alias commonly passed by external CI/CD pipelines,
#   container environments (e.g., Docker, runner environments), or generic shell
#   profiles where workspace paths are conventionally exposed as WORK_DIR.
#   Evaluated as a fallback when FLEET_ROOT is omitted or invalid.
FLEET_ROOT=
WORK_DIR=

# ------------------------------------------------------------------------------
# 5. SLACK OPERATIONS BRIDGE CREDENTIALS (PACKAGES/924.SLACK)
# ------------------------------------------------------------------------------
# Bot User OAuth Token (format: xoxb-...)
SLACK_BOT_TOKEN=xoxb-your_slack_bot_token_here

# Signing secret from Slack App Management -> Basic Information
SLACK_SIGNING_SECRET=your_slack_signing_secret_here

# Default channel ID or name for broadcast telemetry
SLACK_CHANNEL_ID=#ops-bridge

# Dedicated channel ID for Jules agent operations
SLACK_JULES_CHANNEL_ID=C0C4CK27LA1

# Comma-separated list of authorized Slack User IDs for approval gates
SLACK_AUTHORIZED_APPROVERS=U01234567

# ------------------------------------------------------------------------------
# 6. DOMAIN PIVOT SERVICE ENDPOINTS (OPTIONAL)
# ------------------------------------------------------------------------------
HOTKEY_URL=https://zero00-hotkey.onrender.com/api/hotkey/test
FACTORY_URL=
JULES_URL=
GEMINI_URL=

# ------------------------------------------------------------------------------
# 7. ASSET & LORE DIRECTORY OVERRIDES (05.GEARS.UNIT)
# ------------------------------------------------------------------------------
GEARS=
SEARCH=
LORE=
